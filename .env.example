# Base de données SQLite (fichier local, créé automatiquement par Prisma)
DATABASE_URL="file:./dev.db"

# Secret pour NextAuth (générer une valeur aléatoire en production)
# Exemple : openssl rand -base64 32
AUTH_SECRET="change-me-in-production-use-a-random-string"

# URL de l'application (optionnel, utile en production)
NEXTAUTH_URL="http://localhost:3000"
